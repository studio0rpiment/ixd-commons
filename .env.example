# Notion — internal integration token with read/write on the listings database
NOTION_TOKEN=secret_xxx
# Data source id of the listings database (Notion API 2025+; find it in the
# database's "Manage data sources" menu or via /v1/databases/{id})
NOTION_LISTINGS_DS=b0532343-3452-4f8b-817c-1c3442c40e1f
# Secret you set when creating the Notion webhook subscription (optional but recommended)
NOTION_WEBHOOK_SECRET=

# Inbound email
# Resend inbound (preferred): API key + the webhook signing secret (whsec_…)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Same secret configured on the mail provider's webhook (header x-webhook-secret or ?secret=)
INBOUND_WEBHOOK_SECRET=
# Who may forward emails into the pipeline. Addresses or @domains, comma-separated.
INBOUND_ALLOWLIST=@gwu.edu

